@model List<TP5.Models.RestosModel.Restaurant>

<h2>Avis par restaurant</h2>
@foreach (var resto in Model)
{
    <h4>@resto.NomResto</h4>
    <ul>
        @foreach (var avis in resto.LesAvis)
        {
            <li>
                <strong>@avis.NomPersonne</strong> - Note: @avis.Note <br />
                @avis.Commentaire
            </li>
        }
    </ul>
}
