@model IEnumerable<dynamic>

<h2>Restaurants avec note moyenne ≥ 3.5</h2>

<table class="table">
    <thead>
        <tr>
            <th>Nom</th>
            <th>Spécialité</th>
            <th>Ville</th>
            <th>Moyenne</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Resto.NomResto</td>
                <td>@item.Resto.Specialite</td>
                <td>@item.Resto.Ville</td>
                <td>@item.Moyenne.ToString("0.00")</td>
            </tr>
        }
    </tbody>
</table>
